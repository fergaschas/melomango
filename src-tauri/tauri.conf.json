{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melomango",
  "version": "0.5.0",
  "identifier": "com.melomango.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melomango",
        "width": 1200,
        "height": 780,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "publisher": "Melomango",
    "copyright": "© 2026 Melomango",
    "category": "Music",
    "homepage": "https://github.com/fergaschas/melomango",
    "shortDescription": "Reproductor de música en streaming gratuito",
    "longDescription": "Melomango es un reproductor de música en streaming gratuito para escritorio: Audius integrado, plugins instalables (como YouTube), playlists, Me gusta y letras sincronizadas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": [
          "es-ES",
          "en-US"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QkMxNUFGQkUwQzJBNEQKUldSTktneStyeFc4bHZQYkxQdTZoTW8wMGdUTTBaNzIxa0Q3VlRvRjJ5TCtpMkI2YzdHOW1RRjEK",
      "endpoints": [
        "https://github.com/fergaschas/melomango/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
